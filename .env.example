NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-440EEFRNG7
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Polar — create monthly + annual Pro products (or one product + POLAR_PRODUCT_ID)
# Use production products + production token with POLAR_SERVER=production on amisearchable.cc
# Use sandbox products + sandbox token with POLAR_SERVER=sandbox for local testing only
# Webhook URL must use the canonical host that does NOT 308-redirect.
# Vercel currently redirects amisearchable.cc → www.amisearchable.cc, so use:
#   https://www.amisearchable.cc/api/webhooks/polar
# Events: checkout.updated, subscription.created/updated/active/canceled/revoked/uncanceled
# Token scopes: checkouts:read/write, subscriptions:read, customers:read, customer_sessions:write
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_PRODUCT_MONTHLY_ID=
POLAR_PRODUCT_ANNUAL_ID=
POLAR_SERVER=production

# Resend — verify amisearchable.cc in Resend (SPF/DKIM). Use a display name optionally:
# ALERT_FROM_EMAIL="Am I Searchable <alert@amisearchable.cc>"
RESEND_API_KEY=
ALERT_FROM_EMAIL=alert@amisearchable.cc

# Cron
CRON_SECRET=
